# 服务端环境变量样例（复制为 .env.local 并按本机实际值填写）
# 注意：.env.local / .env 已被 git 忽略，不会提交到仓库。
# Linux/macOS 运行前： set -a; source .env.local; set +a
# Windows PowerShell 运行前： Get-Content .env.local | ForEach-Object { $_ -split '=',2 | Set-Item -Path ("Env:"+$_[0]) -Value $_[1] }
# 或在 IDE 的 Run Configuration 里逐个添加环境变量。

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_trade
DB_USERNAME=campus_app
DB_PASSWORD=请替换为你的真实密码

# ---- JWT 签名密钥（建议 32+ 位随机串，可用 openssl rand -hex 32 生成）----
JWT_SECRET=请替换为你的随机密钥

# ---- 图片存储（可选，有默认值）----
# UPLOAD_DIR=./uploads/
# ACCESS_URL=http://localhost:8080/images/
