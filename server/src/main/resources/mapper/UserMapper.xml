<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.UserMapper">

    <select id="findByEmail" resultType="com.campus.trade.entity.User">
        SELECT * FROM `user` WHERE email = #{email} LIMIT 1
    </select>

    <select id="findById" resultType="com.campus.trade.entity.User">
        SELECT * FROM `user` WHERE id = #{id} LIMIT 1
    </select>

    <insert id="insert" parameterType="com.campus.trade.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (email, password_hash, salt, nickname, avatar, phone, grade, major)
        VALUES (#{email}, #{passwordHash}, #{salt}, #{nickname}, #{avatar}, #{phone}, #{grade}, #{major})
    </insert>

    <update id="updateProfile" parameterType="com.campus.trade.entity.User">
        UPDATE `user`
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="grade != null">grade = #{grade},</if>
            <if test="major != null">major = #{major},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE `user`
        SET password_hash = #{passwordHash}, salt = #{salt}
        WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE `user` SET status = #{status} WHERE id = #{id}
    </update>
</mapper>
