<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.CategoryMapper">

    <select id="listAll" resultType="com.campus.trade.entity.Category">
        SELECT * FROM category
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findById" resultType="com.campus.trade.entity.Category">
        SELECT * FROM category WHERE id = #{id} LIMIT 1
    </select>
</mapper>
